# AutoAttend Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=autoattend-super-secret-key-2026-secure-jwt-hash

# sqlite starts with no extra database server. Use mysql when that server is available.
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=autoattend_db

# Face Recognition Settings
CAMERA_INDEX=0
FACE_MATCH_THRESHOLD=0.65
MIN_OBSERVATIONS=3
FRAME_CAPTURE_INTERVAL=1.5
DEMO_MODE=false
