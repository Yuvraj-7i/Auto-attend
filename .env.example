# AutoAttend Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=autoattend-super-secret-key-2026-secure-jwt-hash

# Database Configuration (MySQL)
# Default DB_TYPE is mysql; will automatically use sqlite as fallback if MySQL server is unreachable
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=autoattend_db

# Face Recognition Settings
CAMERA_INDEX=0
FACE_MATCH_THRESHOLD=0.65
MIN_OBSERVATIONS=3
FRAME_CAPTURE_INTERVAL=1.5
DEMO_MODE=false
